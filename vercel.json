{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "^/(?:server\\.js|package(?:-lock)?\\.json|vercel\\.json|start\\.sh|api/index\\.js|\\.env(?:\\..*)?|\\.git(?:/.*)?)$",
      "dest": "/not-found.html",
      "status": 404
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
